# Keep the build context small and secrets/artifacts out of the image.
.git
.github
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache

# Secrets and local data (injected/created at runtime instead)
.env
data/
logs/

# Not needed in the runtime image
tests/
docs/
.pre-commit-config.yaml
