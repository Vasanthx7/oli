# =============================================================================
# Oli configuration. Two roles, cleanly separated (see ADR 0017):
#   • Cloud LLMs  → all non-vision work (chat, reasoning, intent, memory), with
#                   automatic failover across an ordered provider chain.
#   • Local model → computer-use (browse) ONLY, via a local Fara-1.5 vision model.
# =============================================================================

# --- Cloud LLM providers (chat / reasoning / intent / memory) ---
# The chain is tried in order; if the primary is down or rate-limited, the next one
# answers, and the user is told a fallback was used. Each provider is OpenAI-compatible
# (endpoint + key + a strong `MODEL` + a cheap `FAST_MODEL` for the intent classifier
# and simple chat turns).

# Provider 1 — Groq (primary).
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Provider 2 — Mistral (failover). Add a key to enable it; with no key it is dropped
# from the chain (no dead fallback), so a Groq-only setup needs nothing here.
# MISTRAL_API_KEY=your-mistral-api-key-here
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_FAST_MODEL=mistral-small-latest

# Failover order by provider name. Only keyed providers are used; the first keyed one
# is the primary. Reorder to prefer another (e.g. "mistral,groq").
# CLOUD_PROVIDER_ORDER=groq,mistral

# --- Computer-use: local Fara-1.5 vision model (see ADR 0016/0017) ---
# The ONLY local workload. `browse` runs the native Fara-1.5 computer-use loop against a
# local Ollama in BOTH dev and production. Vision-only, its own action loop, watch +
# take-control. No cloud fallback: if the host is unreachable the tool returns a clear
# "unavailable" message (optionally a link to a recorded run — good for a demo/recruiter).
BROWSE_ENGINE=fara
#
# Local dev (Ollama on this machine):
FARA_BASE_URL=http://localhost:11434/v1
FARA_MODEL=fara15-4b
FARA_API_KEY=ollama
#
# Production: the deploy VM reaches the developer's machine over TAILSCALE, so point
# FARA_BASE_URL at that machine's Tailscale IP/MagicDNS name (NOT localhost), e.g.:
# FARA_BASE_URL=http://100.86.165.95:11434/v1
# IMPORTANT: Ollama must listen beyond localhost for the VM to reach it — set
# OLLAMA_HOST=0.0.0.0 on the Ollama host and restart Ollama (it binds localhost-only
# by default). When the host is offline, point users at a recorded run:
# FARA_UNAVAILABLE_URL=https://.../workflow-recording

# --- Harness guardrails (per-turn safety rails) ---
# MAX_TOOL_CALLS_PER_TURN=8      # end a turn after this many tool calls
# PER_TURN_TOKEN_BUDGET=0        # 0 = disabled; else cap total LLM tokens per turn
# TOOL_TIMEOUT_SECONDS=180       # 0 = disabled; hard timeout on a single tool call

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Access control (HTTP Basic Auth over the whole app) ---
# The app is single-user but internet-facing, so every endpoint (and the live-browser
# WebSocket) sits behind Basic Auth. Auth turns ON only when AUTH_PASSWORD is set —
# leave it empty for local dev/tests. SET A STRONG PASSWORD before exposing to the
# internet (startup logs a warning in production if it's missing).
# AUTH_USERNAME=oli
# AUTH_PASSWORD=generate-a-long-random-password

# --- Database ---
# Defaults to a local SQLite file if unset. For Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://oli:oli@localhost:5432/oli

# --- Observability (optional) ---
# LOG_JSON=true                 # JSON logs (recommended in production)
# LANGSMITH_TRACING=true        # trace the agent to LangSmith
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=oli
