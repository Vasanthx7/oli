# --- LLM provider (Groq, OpenAI-compatible API) ---
GROQ_API_KEY=your-groq-api-key-here

# Base defaults. The chat and browser models inherit these unless overridden below.
GROQ_MODEL=openai/gpt-oss-120b
BROWSER_MODEL=openai/gpt-oss-120b

# --- Hybrid: local chat model, Groq for browsing (see ADR 0010) ---
# The chat/reasoning model and browser model each have their own endpoint/key/model,
# so you can run chat on a local model (no rate limits, no cost) while keeping the
# strong Groq model for browser-use. Leave the CHAT_* lines commented to stay fully
# on Groq. Example using a local Ollama with qwen2.5:7b-instruct:
# CHAT_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen2.5:7b-instruct
# CHAT_API_KEY=ollama
#
# Browser stays on Groq by default (inherits GROQ_*). Browse LLM calls are paced to
# this per-minute ceiling to avoid Groq 429s (0 = unlimited):
# BROWSER_MAX_RPM=27

# --- Model routing: fast vs strong tier (see ADR 0014) ---
# The intent classifier and simple chat turns use the fast tier; hard or tool-needing
# turns use CHAT_MODEL (the strong tier). Default fast model is a small Groq model.
# On a hybrid-local setup (CHAT_* pointed at Ollama) set this to a small LOCAL model —
# llama-3.1-8b-instant only exists on Groq. Set equal to CHAT_MODEL to disable tiering.
# CHAT_FAST_MODEL=llama-3.1-8b-instant

# --- Harness guardrails (per-turn safety rails) ---
# MAX_TOOL_CALLS_PER_TURN=8      # end a turn after this many tool calls
# PER_TURN_TOKEN_BUDGET=0        # 0 = disabled; else cap total LLM tokens per turn
# TOOL_TIMEOUT_SECONDS=180       # 0 = disabled; hard timeout on a single tool call

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Database ---
# Defaults to a local SQLite file if unset. For Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://oli:oli@localhost:5432/oli

# --- Observability (optional) ---
# LOG_JSON=true                 # JSON logs (recommended in production)
# LANGSMITH_TRACING=true        # trace the agent to LangSmith
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=oli
